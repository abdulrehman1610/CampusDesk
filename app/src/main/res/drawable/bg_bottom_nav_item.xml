<?xml version="1.0" encoding="utf-8"?>
<!-- Centered crimson rounded-rectangle pill behind the selected BottomNavigationView tab.
     Symmetric insets keep the active pill centered inside the dark floating dock on all screen widths. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetBottom="6dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/crimson" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset
            android:insetBottom="6dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/crimson" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</selector>
