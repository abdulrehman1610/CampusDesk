<?xml version="1.0" encoding="utf-8"?>
<!-- Semi-transparent white pill on top of the dark header (header search bar, badges). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_white" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
