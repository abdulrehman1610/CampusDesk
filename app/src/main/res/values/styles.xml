<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable styles. A layout writes style="@style/Text.Heading" instead of repeating
     the same size/color/font on every TextView. -->
<resources>

    <!-- ===== Text styles ===== -->

    <!-- Big white title on the gradient header (e.g. "Hello Sign in!") -->
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
    </style>

    <!-- Screen title on the header (e.g. "Create Your Account") -->
    <style name="Text.HeaderTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <!-- Small white text on the header -->
    <style name="Text.HeaderSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_on_dark_muted</item>
    </style>

    <!-- Section / card heading in dark text -->
    <style name="Text.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <!-- Normal body text -->
    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Grey secondary text -->
    <style name="Text.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Form field label above an input (e.g. "Full Name") -->
    <style name="Text.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- Tiny uppercase caption (e.g. "DESK PREFERENCES") -->
    <style name="Text.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- Crimson clickable text (e.g. "Create account") -->
    <style name="Text.Link" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/crimson_dark</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <!-- Monospace ticket id (e.g. "#C-0042") -->
    <style name="Text.TicketId" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/crimson_dark</item>
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
    </style>

    <!-- Small pill badge text (status / priority) -->
    <style name="Text.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- Centered, non-shifting label style for BottomNavigationView items -->
    <style name="Text.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Centered, clean text style for Admin TabLayout items -->
    <style name="Text.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== Buttons ===== -->

    <!-- Main crimson pill button (e.g. "Sign in to Console") -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="backgroundTint">@color/crimson</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textEnd</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Light blue pill button (e.g. "SLA Rules", "Details") -->
    <style name="Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="backgroundTint">@color/chip_blue</item>
        <item name="android:textColor">@color/midnight</item>
        <item name="iconTint">@color/midnight</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- Soft pink pill button (e.g. "Sign Out of Desk") -->
    <style name="Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="backgroundTint">@color/pink_soft</item>
        <item name="android:textColor">@color/crimson_dark</item>
        <item name="iconTint">@color/crimson_dark</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- ===== Text inputs ===== -->

    <!-- Light blue pill text field without an outline (Login / Register inputs) -->
    <style name="Input.Pill" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_card</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="errorEnabled">false</item>
    </style>

    <!-- Text inside a pill input -->
    <style name="Input.Text" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_l</item>
    </style>

    <!-- ===== Cards ===== -->

    <!-- White rounded card used for list items (PRD: rounded corners, 16dp padding) -->
    <style name="Card.List" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_card_large</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">@dimen/space_l</item>
    </style>
</resources>
