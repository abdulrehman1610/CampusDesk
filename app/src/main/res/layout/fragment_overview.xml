<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Admin Overview Tab layout. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <!-- 2x2 Minimal Stat Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Pending -->
            <LinearLayout
                android:id="@+id/cardMetricPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_pink"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_square_crimson">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/overview_label_pending"
                        android:src="@drawable/ic_metric_pending" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvMetricPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_label_pending"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/tvMetricTotalSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Resolved -->
            <LinearLayout
                android:id="@+id/cardMetricResolved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_blue"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_square_midnight">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/overview_label_resolved"
                            android:src="@drawable/ic_metric_resolved" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMetricResolvedRateTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_chip_blue"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/midnight"
                        android:textSize="@dimen/text_caption" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvMetricResolvedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_label_resolved"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/overview_sub_resolved"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Notices -->
            <LinearLayout
                android:id="@+id/cardMetricNotices"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_pink"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_square_midnight">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/overview_label_notices"
                        android:src="@drawable/ic_metric_notices" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvMetricNoticesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_label_notices"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <!-- Users -->
            <LinearLayout
                android:id="@+id/cardMetricUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_blue"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_square_midnight">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/overview_label_users"
                        android:src="@drawable/ic_metric_users" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvMetricUsersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_label_users"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Clean Resolution Progress Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_box"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/overview_pace_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                android:id="@+id/tvOverviewPaceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small" />

            <ProgressBar
                android:id="@+id/progressResolutionRate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="65"
                android:progressTint="@color/crimson" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvOverviewResolvedPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvOverviewPendingPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Compact Pending Queue Banner -->
        <LinearLayout
            android:id="@+id/cardQueueAttention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dark_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_square_crimson">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/overview_queue_title"
                    android:src="@drawable/ic_queue_alarm" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/overview_queue_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvOverviewQueueSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:maxLines="1"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <ImageView
                android:layout_width="7dp"
                android:layout_height="10dp"
                android:contentDescription="@string/overview_queue_title"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Equal-Width Responsive Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverviewPostNotice"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="46dp"
                android:text="@string/overview_btn_post_notice"
                android:textSize="@dimen/text_body"
                app:icon="@drawable/ic_plus_circle"
                app:iconGravity="textStart" />

            <Button
                android:id="@+id/btnOverviewViewQueue"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="46dp"
                android:text="@string/overview_btn_view_queue"
                android:textSize="@dimen/text_body"
                app:icon="@drawable/ic_sliders"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Recent Complaints Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/overview_recent_filings"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                android:id="@+id/tvOverviewViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:padding="4dp"
                android:textColor="@color/crimson_dark"
                android:textSize="@dimen/text_small" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverviewRecentComplaints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvOverviewRecentEmpty"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/space_l"
            android:text="@string/overview_recent_empty"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
