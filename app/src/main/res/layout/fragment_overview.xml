<?xml version="1.0" encoding="utf-8"?>
<!-- Admin Overview Tab layout matching Figma node 2:1160 "Admin Overview (Crimson Dynamic)" & PRD D2.
     Displays the 2x2 Tactile Metric Tiles (Pending, Resolved, Notices, Users + Total filings),
     Resolution Pace SLA Progress Card, Queue Attention Alert Card, Action Shortcuts, and Recent Filings. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- 2x2 Tactile Metric Tiles (Figma 2:1234 & PRD D2) -->
        <!-- Row 1: Pending Review + Resolved Cases -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Card 1: Pending Review -->
            <LinearLayout
                android:id="@+id/cardMetricPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_pink"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_square_crimson">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/overview_label_pending"
                            android:src="@drawable/ic_metric_pending" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_chip_pink"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/overview_tag_req_action"
                        android:textColor="@color/crimson_dark"
                        android:textSize="@dimen/text_tiny" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvMetricPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/overview_label_pending"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvMetricTotalSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Card 2: Resolved Cases -->
            <LinearLayout
                android:id="@+id/cardMetricResolved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_blue"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_square_midnight">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/overview_label_resolved"
                            android:src="@drawable/ic_metric_resolved" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMetricResolvedRateTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_chip_blue"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/midnight"
                        android:textSize="@dimen/text_tiny" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvMetricResolvedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/overview_label_resolved"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_sub_resolved"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Campus Notices + Student/Faculty Users -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Card 3: Campus Notices -->
            <LinearLayout
                android:id="@+id/cardMetricNotices"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_pink"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_square_midnight">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/overview_label_notices"
                            android:src="@drawable/ic_metric_notices" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_chip_pink"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/overview_tag_active"
                        android:textColor="@color/text_label_warm"
                        android:textSize="@dimen/text_tiny" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvMetricNoticesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/overview_label_notices"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_sub_notices"
                    android:textColor="@color/text_label_warm"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Card 4: Student / Faculty Users -->
            <LinearLayout
                android:id="@+id/cardMetricUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_blue"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_icon_square_midnight">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/overview_label_users"
                            android:src="@drawable/ic_metric_users" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_chip_blue"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/overview_tag_enrolled"
                        android:textColor="@color/midnight"
                        android:textSize="@dimen/text_tiny" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvMetricUsersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/overview_label_users"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/overview_sub_users"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Resolution Pace SLA Progress Card (Figma 2:1312) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_white_box"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/overview_pace_title"
                        android:src="@drawable/ic_chart_pace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/overview_pace_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_large" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_blue"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/overview_pace_goal"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvOverviewPaceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <ProgressBar
                android:id="@+id/progressResolutionRate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="65"
                android:progressTint="@color/crimson" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvOverviewResolvedPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/tvOverviewPendingPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Filing Queue Status Alert Card (Figma 2:1336) -->
        <LinearLayout
            android:id="@+id/cardQueueAttention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dark_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_square_crimson">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/overview_queue_title"
                    android:src="@drawable/ic_queue_alarm" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/overview_queue_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_large" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_crimson"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/overview_queue_badge"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_tiny" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOverviewQueueSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle_glass">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/overview_queue_title"
                    android:src="@drawable/ic_chevron_right" />
            </FrameLayout>
        </LinearLayout>

        <!-- Action Shortcuts: Post Notice + Manage Queue (Figma 2:1352) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverviewPostNotice"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/overview_btn_post_notice"
                app:icon="@drawable/ic_plus_circle"
                app:iconGravity="textStart" />

            <Button
                android:id="@+id/btnOverviewViewQueue"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/overview_btn_view_queue"
                app:icon="@drawable/ic_sliders"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Recent Filings Section Header (Figma 2:1365) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/overview_recent_filings"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                android:id="@+id/tvOverviewViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:padding="4dp"
                android:textColor="@color/crimson_dark"
                android:textSize="@dimen/text_body" />
        </RelativeLayout>

        <!-- RecyclerView of the latest 3 complaints -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverviewRecentComplaints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvOverviewRecentEmpty"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/space_l"
            android:text="@string/overview_recent_empty"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
