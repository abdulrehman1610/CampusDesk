<?xml version="1.0" encoding="utf-8"?>
<!-- Complaint Detail screen layout (PRD U7, U8, U9).
     Displays all complaint fields, the admin reply (or "No reply yet"),
     and Edit / Delete buttons that are enabled only while status is Pending. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/midnight"
        android:orientation="vertical">

        <!-- Midnight-to-Crimson Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="48dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btnBackComplaintDetail"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_icon_circle_glass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_crimson" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/complaint_detail_badge"
                        android:textColor="@color/text_on_dark"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="@string/complaint_detail_heading"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title_large" />

            <TextView
                android:id="@+id/tvDetailComplaintDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Overlapping White Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_sheet_rounded"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <!-- Top Row: Ticket Code + Status Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvDetailTicketCode"
                    style="@style/Text.TicketId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:id="@+id/tvDetailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_pending"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/status_pending"
                    android:textSize="@dimen/text_body" />
            </RelativeLayout>

            <!-- Category & Priority Chips Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_blue"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/midnight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/tvDetailPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_pink"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <!-- Complaint Title -->
            <TextView
                android:id="@+id/tvDetailComplaintTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title" />

            <!-- Incident Description Box -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/complaint_detail_section_desc" />

            <TextView
                android:id="@+id/tvDetailComplaintDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <!-- Official Admin Reply Box (PRD U7) -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/complaint_detail_section_reply" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetailAdminReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_large" />
            </LinearLayout>

            <!-- Pending Actions Container: Edit & Delete only while status == Pending (PRD U8, U9) -->
            <LinearLayout
                android:id="@+id/layoutPendingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnEditComplaint"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/complaint_btn_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textEnd" />

                <Button
                    android:id="@+id/btnDeleteComplaint"
                    style="@style/Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="12dp"
                    android:text="@string/complaint_btn_delete" />
            </LinearLayout>

            <!-- Resolved Lock Note (shown when complaint is Resolved and cannot be edited/deleted) -->
            <TextView
                android:id="@+id/tvResolvedLockNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_badge_resolved"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/complaint_detail_resolved_locked"
                android:textColor="@color/status_resolved"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
