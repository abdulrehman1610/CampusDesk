<?xml version="1.0" encoding="utf-8"?>
<!-- Edit Complaint screen layout (PRD U8: opened with ActivityResultLauncher, returns RESULT_OK). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/midnight"
        android:orientation="vertical">

        <!-- Midnight-to-Crimson Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="48dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btnBackEditComplaint"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_icon_circle_glass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_crimson" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/edit_complaint_badge"
                        android:textColor="@color/text_on_dark"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="@string/edit_complaint_heading"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title_large" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/edit_complaint_subtitle"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Overlapping White Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_sheet_rounded"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- 1. Complaint Title -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_complaint_label_title" />

            <EditText
                android:id="@+id/etEditComplaintTitle"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:hint="@string/new_complaint_hint_title"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body_large" />

            <!-- 2. Category Spinner (PRD Section 3: Spinner fallback for category) -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/new_complaint_label_category" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_box"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Spinner
                    android:id="@+id/spinnerEditCategory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 3. Priority RadioGroup -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/new_complaint_label_urgency" />

            <RadioGroup
                android:id="@+id/rgEditPriority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbEditPriorityLow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_low"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbEditPriorityMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_medium"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbEditPriorityHigh"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_high"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <!-- 4. Detailed Description -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/new_complaint_label_description" />

            <EditText
                android:id="@+id/etEditComplaintDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="top|start"
                android:hint="@string/new_complaint_hint_description"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="3dp"
                android:maxLength="500"
                android:minLines="5"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body_large" />

            <!-- Save Changes Button -->
            <Button
                android:id="@+id/btnSaveEditedComplaint"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="24dp"
                android:text="@string/edit_complaint_btn_save"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
