<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive New Complaint Tab layout (GridView + RadioGroup). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_list_clearance">

        <!-- Compact Midnight Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/midnight_soft"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/new_complaint_hero_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/new_complaint_hero_subtitle"
                android:textColor="@color/outline"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <!-- Clean Overlapping Form Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:background="@drawable/bg_sheet_rounded"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="20dp">

            <!-- 1. Title -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_complaint_label_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/new_complaint_label_title"
                    android:src="@drawable/ic_title_edit" />

                <EditText
                    android:id="@+id/etComplaintTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="@string/new_complaint_hint_title"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- 2. Category GridView -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/new_complaint_label_category" />

                <TextView
                    android:id="@+id/tvSelectedCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <!-- 2-column responsive GridView (3 rows x 94dp + 2 x 10dp spacing = 302dp) -->
            <GridView
                android:id="@+id/gvCategories"
                android:layout_width="match_parent"
                android:layout_height="304dp"
                android:layout_marginTop="8dp"
                android:horizontalSpacing="10dp"
                android:listSelector="@color/transparent"
                android:numColumns="2"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <!-- 3. Priority RadioGroup -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/new_complaint_label_urgency" />

            <RadioGroup
                android:id="@+id/rgPriority"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbPriorityLow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_low"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbPriorityMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:checked="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_medium"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbPriorityHigh"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_high"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <!-- 4. Description -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/new_complaint_label_description" />

                <TextView
                    android:id="@+id/tvCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <EditText
                android:id="@+id/etComplaintDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="top|start"
                android:hint="@string/new_complaint_hint_description"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="2dp"
                android:maxLength="500"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- 5. Submit Button -->
            <Button
                android:id="@+id/btnSubmitComplaint"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:text="@string/new_complaint_btn_submit"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
