<?xml version="1.0" encoding="utf-8"?>
<!-- New Complaint Tab layout matching Figma node 2:253 "New Complaint (Crimson Dynamic)".
     Demonstrates GridView with custom BaseAdapter (categories) and RadioGroup (priority) (PRD U5). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <!-- Top Midnight Banner with Dynamic Curved Cutout Framing (Figma 2:256) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/midnight_soft"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="13dp"
                        android:contentDescription="@string/new_complaint_routing_badge"
                        android:src="@drawable/ic_shield_fill"
                        app:tint="@color/pink_soft" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/new_complaint_routing_badge"
                        android:textColor="@color/pink_soft"
                        android:textSize="@dimen/text_tiny" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="@string/new_complaint_step_label"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/new_complaint_hero_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:lineSpacingExtra="2dp"
                android:text="@string/new_complaint_hero_subtitle"
                android:textColor="@color/outline"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <!-- Elevated Sheet Content Container (Figma 2:272) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_sheet_rounded"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- 1. Complaint Title Input Block (Figma 2:273) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/new_complaint_label_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="@string/new_complaint_label_brief"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/new_complaint_label_title"
                    android:src="@drawable/ic_title_edit" />

                <EditText
                    android:id="@+id/etComplaintTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="@string/new_complaint_hint_title"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- 2. Incident Category GridView (Figma 2:286 & PRD U5) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/new_complaint_label_category"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvSelectedCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <!-- 2-column GridView holding the 6 category tiles (3 rows x 136dp + 2 x 10dp spacing = 428dp) -->
            <GridView
                android:id="@+id/gvCategories"
                android:layout_width="match_parent"
                android:layout_height="432dp"
                android:layout_marginTop="8dp"
                android:horizontalSpacing="10dp"
                android:listSelector="@color/transparent"
                android:numColumns="2"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <!-- 3. Urgency Level RadioGroup Pills (Figma 2:348 & PRD U5) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/new_complaint_label_urgency"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <RadioGroup
                android:id="@+id/rgPriority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbPriorityLow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_low"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbPriorityMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:checked="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_medium"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/rbPriorityHigh"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_option"
                    android:button="@null"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="@string/priority_high"
                    android:textColor="@color/segment_text_color"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <!-- 4. Detailed Description Textarea (Figma 2:364) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:text="@string/new_complaint_label_description"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/etComplaintDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:gravity="top|start"
                    android:hint="@string/new_complaint_hint_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="2dp"
                    android:maxLength="500"
                    android:minLines="4"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/new_complaint_confidential_note"
                        android:src="@drawable/ic_lock_grey" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/new_complaint_confidential_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Central Registrar Oversight Dark Card (Figma 2:409) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_dark_card"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_crimson">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/new_complaint_oversight_title"
                        android:src="@drawable/ic_oversight_shield" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/new_complaint_oversight_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/new_complaint_oversight_body"
                        android:textColor="@color/outline"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Submit Complaint Crimson Pill Button (Figma 2:419) -->
            <Button
                android:id="@+id/btnSubmitComplaint"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:text="@string/new_complaint_btn_submit"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="center"
                android:text="@string/new_complaint_code_of_conduct"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
