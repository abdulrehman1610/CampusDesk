<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Admin Complaint Detail & Reply screen layout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <!-- Compact Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnBackAdminComplaintDetail"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/bg_icon_circle_glass">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_back"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/admin_detail_heading"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:id="@+id/tvAdminDetailStudentAndDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:maxLines="1"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Clean Overlapping White Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-18dp"
            android:background="@drawable/bg_sheet_rounded"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="22dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <!-- Ticket ID + Status Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvAdminDetailTicketCode"
                    style="@style/Text.TicketId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:id="@+id/tvAdminDetailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_pending"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/status_pending"
                    android:textSize="@dimen/text_small" />
            </RelativeLayout>

            <!-- Category + Priority Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAdminDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_blue"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/midnight"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvAdminDetailPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_pink"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/complaint_detail_section_desc" />

            <TextView
                android:id="@+id/tvAdminDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:lineSpacingExtra="3dp"
                android:padding="@dimen/card_padding"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_detail_reply_label" />

            <EditText
                android:id="@+id/etAdminReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_box"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:gravity="top|start"
                android:hint="@string/admin_detail_reply_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="3dp"
                android:minLines="4"
                android:padding="@dimen/card_padding"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body_large" />

            <Button
                android:id="@+id/btnMarkResolved"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="18dp"
                android:text="@string/admin_btn_mark_resolved"
                app:icon="@drawable/ic_check_white"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMarkPending"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/admin_btn_mark_pending"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/btnAdminDeleteComplaint"
                    style="@style/Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/admin_btn_delete_complaint"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
