<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Admin Notices Tab layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding">

        <!-- Search Bar with Total Count Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:contentDescription="@string/admin_notices_search_hint"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/etSearchAdminNotices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/admin_notices_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/tvAdminNoticeCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_crimson"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Notices RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminNotices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/bottom_list_clearance" />

        <TextView
            android:id="@+id/tvEmptyAdminNotices"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/admin_notices_empty"
            android:visibility="gone" />
    </LinearLayout>

    <!-- + New Notice Floating Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddNotice"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:text="@string/admin_notices_fab_new"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/crimson"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/white" />

</FrameLayout>
