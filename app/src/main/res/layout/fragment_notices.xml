<?xml version="1.0" encoding="utf-8"?>
<!-- User Notices Tab layout matching Figma node 2:467 "Notices (Crimson Dynamic)".
     Features the Midnight Top Bleed with Urgent Broadcast Banner + Search Pill Bar,
     Overlapping Rounded Surface Canvas with Category Filter Pills, and Notices RecyclerView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top Curved Midnight Header Bleed (Figma 2:470) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/midnight_soft"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Urgent Broadcast Pill Banner showing the newest notice title (Figma 2:471) -->
        <RelativeLayout
            android:id="@+id/layoutUrgentBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_urgent_banner"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/frameUrgentIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_crimson">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/user_notices_urgent_tag"
                    android:src="@drawable/ic_urgent_flame" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUrgentTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/frameUrgentIcon"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/user_notices_urgent_tag"
                android:textColor="@color/pink_soft"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/tvUrgentNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/ivUrgentChevron"
                android:layout_toEndOf="@id/tvUrgentTag"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_small" />

            <ImageView
                android:id="@+id/ivUrgentChevron"
                android:layout_width="6dp"
                android:layout_height="9dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/user_notices_urgent_tag"
                android:src="@drawable/ic_chevron_right" />
        </RelativeLayout>

        <!-- Search Pill Bar inside the midnight header (Figma 2:485 & PRD U4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="15dp"
                android:contentDescription="@string/user_notices_search_hint"
                android:src="@drawable/ic_search"
                app:tint="@color/outline" />

            <EditText
                android:id="@+id/etSearchUserNotices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/user_notices_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="13dp"
                android:contentDescription="@string/user_notices_search_hint"
                android:src="@drawable/ic_sliders"
                app:tint="@color/outline" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Overlapping Curved Surface Canvas (Figma 2:495) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-20dp"
        android:background="@drawable/bg_sheet_rounded"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <!-- Category Horizontal Filter Pills (Figma 2:497) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_crimson"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/user_notices_chip_all"
                        android:src="@drawable/ic_sparkles" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/user_notices_chip_all"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/user_notices_chip_academics"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/user_notices_chip_accounts"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_pill"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/user_notices_chip_facilities"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- RecyclerView of Notice Cards (PRD U1) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUserNotices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />

        <!-- Empty-state TextView (PRD U11) -->
        <TextView
            android:id="@+id/tvEmptyUserNotices"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/user_notices_empty"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
