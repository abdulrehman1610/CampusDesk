<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Student Notices Tab layout.
     Compact midnight header with latest notice banner & search bar, clean surface canvas,
     and RecyclerView with generous spacing from all borders. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Compact Midnight Header with Latest Banner + Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/midnight_soft"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="28dp">

        <!-- Latest Notice Banner -->
        <LinearLayout
            android:id="@+id/layoutUrgentBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_urgent_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_circle_crimson">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/user_notices_urgent_tag"
                    android:src="@drawable/ic_urgent_flame" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/user_notices_urgent_tag"
                android:textColor="@color/pink_soft"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tvUrgentNoticeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_small" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="9dp"
                android:contentDescription="@string/user_notices_urgent_tag"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Search Pill Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:contentDescription="@string/user_notices_search_hint"
                android:src="@drawable/ic_search"
                app:tint="@color/outline" />

            <EditText
                android:id="@+id/etSearchUserNotices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:hint="@string/user_notices_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- Clean Overlapping Surface Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_sheet_rounded"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUserNotices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/bottom_list_clearance" />

        <TextView
            android:id="@+id/tvEmptyUserNotices"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/user_notices_empty"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
