<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Notice Card layout used in Student and Admin notice feeds. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_card_large"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Crimson Accent Stripe -->
        <View
            android:id="@+id/viewAccentStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/crimson" />

        <!-- Main Card Content -->
        <LinearLayout
            android:id="@+id/layoutCardBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- Top Row: Code + Date on left, Admin Edit/Delete icons on right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoticeCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_pink"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/crimson_deep"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvNoticeDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- Admin Action Buttons -->
                <LinearLayout
                    android:id="@+id/layoutAdminNoticeActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnEditNotice"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_blue">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/action_edit"
                            android:src="@drawable/ic_edit" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnDeleteNotice"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_pink">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="13dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/action_delete"
                            android:src="@drawable/ic_trash" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Notice Title -->
            <TextView
                android:id="@+id/tvNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large" />

            <!-- Short Content Preview -->
            <TextView
                android:id="@+id/tvNoticeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
