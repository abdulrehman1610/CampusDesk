<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Admin Dashboard layout.
     Compact Midnight/Crimson header with Toolbar (Logout), responsive centered TabLayout pill bar,
     and ViewPager2 hosting Overview, Complaints, Notices, and Users. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Compact Midnight / Crimson Curved Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:contentInsetStart="4dp"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"
            app:subtitle="@string/admin_dashboard_subtitle"
            app:subtitleTextColor="@color/pink_soft"
            app:title="@string/admin_dashboard_title"
            app:titleTextColor="@color/white" />

        <!-- Compact Summary Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_circle_crimson">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/admin_header_total_filings"
                    android:src="@drawable/ic_folder_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHeaderComplaintCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:maxLines="1"
                android:text="@string/admin_header_recorded_count"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- Responsive Centered Pill Tab Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="6dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_bar_height"
            android:background="@drawable/bg_input_pill"
            android:padding="4dp"
            app:tabBackground="@drawable/bg_tab_item_selector"
            app:tabGravity="fill"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="2dp"
            app:tabPaddingStart="2dp"
            app:tabPaddingTop="0dp"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/white"
            app:tabTextAppearance="@style/Text.Tab"
            app:tabTextColor="@color/text_primary" />
    </FrameLayout>

    <!-- ViewPager2 hosting Overview, Complaints, Notices, Users -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
