<?xml version="1.0" encoding="utf-8"?>
<!-- Admin Dashboard layout matching Figma 2:1160 & 2:1946.
     Uses a curved Midnight/Crimson header with Toolbar (Logout menu) + TabLayout + ViewPager2 (PRD D1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Deep Midnight / Crimson Curved Hero Header (Figma 2:1161) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Toolbar with Campus Desk Admin Portal title and Logout options menu (PRD A6) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            app:subtitle="@string/admin_dashboard_subtitle"
            app:subtitleTextColor="@color/pink_soft"
            app:title="@string/admin_dashboard_title"
            app:titleTextColor="@color/white" />

        <!-- Overall Summary Micro-Bar inside header (Figma 2:1197) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_crimson">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/admin_header_total_filings"
                        android:src="@drawable/ic_folder_white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="@string/admin_header_total_filings"
                        android:textColor="@color/text_on_dark_muted"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvHeaderComplaintCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/admin_header_recorded_count"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_button_crimson"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/admin_header_fy_badge"
                android:textColor="@color/white"
                android:textSize="@dimen/text_tiny" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Sticky Pill Navigation Tab Bar below Header (Figma 2:1994 & PRD D1) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_pill"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_tab_indicator_pill"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/crimson"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/text_secondary" />
    </FrameLayout>

    <!-- ViewPager2 hosting the 4 Admin fragments (Overview, Complaints, Notices, Users) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
