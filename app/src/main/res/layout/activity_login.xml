<?xml version="1.0" encoding="utf-8"?>
<!-- Login Screen layout matching Figma node 2:2 "Login (Crimson Dynamic)".
     Demonstrates ScrollView, ConstraintLayout, LinearLayout, RelativeLayout, and FrameLayout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/midnight">

        <!-- Top Background Hero with Midnight & Crimson Gradient (Figma 2:3) -->
        <LinearLayout
            android:id="@+id/heroContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="40dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="68dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Top Navigation Bar & Brand Badge (Figma 2:14) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_glass_pill">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_cap_white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_large" />
                </LinearLayout>

                <!-- Version / SSO Glass Pill (Figma 2:21) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="@string/login_sso_version"
                        android:textColor="@color/text_on_dark"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Hero Title & Subtext: "Hello Sign in!" (Figma 2:25) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:lineSpacingExtra="2dp"
                android:text="@string/login_hero_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:lineSpacingExtra="2dp"
                android:text="@string/login_hero_subtitle"
                android:textColor="@color/text_on_dark_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Main Card Surface Overlapping the Gradient (Figma 2:33) -->
        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-32dp"
            android:background="@drawable/bg_sheet_rounded"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroContainer"
            app:layout_constraintVertical_bias="0.0">

            <!-- 1. University Email / SSO ID Field (Figma 2:35) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="12dp"
                        android:contentDescription="@string/login_label_email"
                        android:src="@drawable/ic_cap_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/login_label_email"
                        android:textColor="@color/text_label_warm"
                        android:textSize="@dimen/text_body_large" />
                </LinearLayout>

                <!-- Verified SSO pill badge (Figma 2:41) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/login_verified_sso"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_tiny" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Email Input Box (Figma 2:44) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field_bordered"
                android:paddingStart="15dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivEmailIcon"
                    android:layout_width="17dp"
                    android:layout_height="14dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/login_label_email"
                    android:src="@drawable/ic_mail" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@id/ivEmailVerified"
                    android:layout_toEndOf="@id/ivEmailIcon"
                    android:autofillHints="emailAddress"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="@string/login_hint_email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body_large" />

                <ImageView
                    android:id="@+id/ivEmailVerified"
                    android:layout_width="17dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/login_verified_sso"
                    android:src="@drawable/ic_verified_badge" />
            </RelativeLayout>

            <!-- 2. Master Keycode / Password Field (Figma 2:52) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/login_label_password"
                    android:src="@drawable/ic_lock_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="@string/login_label_password"
                    android:textColor="@color/text_label_warm"
                    android:textSize="@dimen/text_body_large" />
            </LinearLayout>

            <!-- Password Input Box (Figma 2:58) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field_bordered"
                android:paddingStart="15dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivKeyIcon"
                    android:layout_width="19dp"
                    android:layout_height="10dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/login_label_password"
                    android:src="@drawable/ic_key" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/ivTogglePassword"
                    android:layout_toEndOf="@id/ivKeyIcon"
                    android:autofillHints="password"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="@string/login_hint_password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body_large" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/login_show_password"
                    android:src="@drawable/ic_eye_off" />
            </RelativeLayout>

            <!-- Credentials Quick Options: Remember device + Show password CheckBoxes + Forgot password (PRD A4, A5) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <CheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/crimson"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="@string/login_remember_device"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:padding="4dp"
                    android:text="@string/login_forgot_password"
                    android:textColor="@color/crimson_dark"
                    android:textSize="@dimen/text_body" />
            </RelativeLayout>

            <!-- Show password CheckBox (PRD requirement A4) -->
            <CheckBox
                android:id="@+id/cbShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/crimson"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="@string/login_show_password"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Primary Sign In Action: Crimson Pill Button (Figma 2:72) -->
            <Button
                android:id="@+id/btnLogin"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="16dp"
                android:text="@string/login_button_sign_in"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd" />

            <!-- Bottom Registration Prompt (Figma 2:118) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="@string/login_no_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_large" />

                <LinearLayout
                    android:id="@+id/layoutCreateAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvCreateAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/login_create_account"
                        android:textColor="@color/crimson_dark"
                        android:textSize="@dimen/text_body_large" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="@string/login_create_account"
                        android:src="@drawable/ic_arrow_up_right" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
