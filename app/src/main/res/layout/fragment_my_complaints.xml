<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive My Complaints Tab layout.
     Clean 3-tile stats bar, search bar, category chips, sort spinner, complaint list,
     and compact Help Desk call row. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_list_clearance">

        <!-- Compact Midnight Stats Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/midnight_soft"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="28dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/my_complaints_track_status"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:id="@+id/tvActiveComplaintsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_button_crimson"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_caption" />
            </RelativeLayout>

            <!-- 3 Equal-Width Stat Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvUserStatTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/my_complaints_stat_total"
                        android:textColor="@color/outline"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_crimson"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvUserStatPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/my_complaints_stat_pending"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_glass"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvUserStatResolved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/my_complaints_stat_resolved"
                        android:textColor="@color/outline"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Clean Overlapping Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:background="@drawable/bg_sheet_rounded"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="16dp">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/my_complaints_search_hint"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearchMyComplaints"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:hint="@string/my_complaints_search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Category Filter Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipCatAll"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_crimson"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/my_complaints_filter_all"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatHostel"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_hostel"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatAcademic"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_academic"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatTransport"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_transport"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatFees"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_fees"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatLibrary"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_library"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/chipCatGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_pill"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/category_general"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section Header + Sort Spinner -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/my_complaints_logs_heading"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_large" />

                    <TextView
                        android:id="@+id/tvTicketCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_blue"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spinnerSortMyComplaints"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Complaints RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyComplaints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyMyComplaints"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_xl"
                android:text="@string/my_complaints_empty"
                android:visibility="gone" />

            <!-- Compact Help Desk Bar (ACTION_DIAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dark_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/my_complaints_escalation_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="@string/my_complaints_escalation_sub"
                        android:textColor="@color/outline"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCallDesk"
                    style="@style/Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/my_complaints_btn_call_desk"
                    android:textSize="@dimen/text_small"
                    app:icon="@drawable/ic_phone_call"
                    app:iconGravity="textStart" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
