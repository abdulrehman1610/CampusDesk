<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive User Dashboard layout.
     Features a compact midnight top bar, full-bleed fragment host, and a centered floating
     midnight BottomNavigationView dock with a responsive centered crimson active pill. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Compact Top Midnight Header Bar -->
    <LinearLayout
        android:id="@+id/headerUserBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/midnight_soft"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_crimson">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_cap_white" />
        </FrameLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"
            app:subtitle="@string/user_subtitle_notices"
            app:subtitleTextColor="@color/white"
            app:title="@string/app_name"
            app:titleTextColor="@color/pink_soft" />
    </LinearLayout>

    <!-- Fragment Container swapped by FragmentManager transactions -->
    <FrameLayout
        android:id="@+id/fragmentContainerUser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerUserBar" />

    <!-- Responsive Centered Floating Bottom Navigation Dock -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavUser"
        android:layout_width="match_parent"
        android:layout_height="@dimen/navbar_height"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/navbar_margin_h"
        android:layout_marginEnd="@dimen/navbar_margin_h"
        android:layout_marginBottom="@dimen/navbar_margin_b"
        android:background="@drawable/bg_bottom_dock"
        android:elevation="10dp"
        android:minHeight="@dimen/navbar_height"
        android:paddingStart="6dp"
        android:paddingTop="0dp"
        android:paddingEnd="6dp"
        android:paddingBottom="0dp"
        app:activeIndicatorLabelPadding="4dp"
        app:backgroundTint="@null"
        app:compatShadowEnabled="false"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@drawable/bg_bottom_nav_item"
        app:itemGravity="center"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemPaddingBottom="0dp"
        app:itemPaddingTop="0dp"
        app:itemRippleColor="@color/transparent"
        app:itemTextAppearanceActive="@style/Text.NavLabel"
        app:itemTextAppearanceActiveBoldEnabled="true"
        app:itemTextAppearanceInactive="@style/Text.NavLabel"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_user" />

</RelativeLayout>
