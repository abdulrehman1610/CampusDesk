<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal, responsive Admin Users Tab layout (ListView + BaseAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/screen_padding">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/admin_users_heading"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvUsersCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_blue"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/midnight"
            android:textSize="@dimen/text_caption" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:text="@string/admin_users_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <ListView
        android:id="@+id/lvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/transparent"
        android:dividerHeight="10dp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/tvEmptyUsers"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:text="@string/admin_users_empty"
        android:visibility="gone" />

</LinearLayout>
